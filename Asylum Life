    local function healthColor(health, maxHealth)
        local ratio = math.clamp(maxHealth > 0 and health / maxHealth or 0, 0, 1)
        local r = ratio < 0.5 and 255 or math.floor(255 - (ratio * 2 - 1) * 255)
        local g = ratio > 0.5 and 255 or math.floor(ratio * 2 * 255)
        return Color3.fromRGB(r, g, 0)
    end


