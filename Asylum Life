function cacheLink()
    if cachedTime + (10*60) < fOsTime() then
        local response = fRequest({
            Url = host .. "/public/start",
            Method = "POST",
            Body = lEncode({
                service = service,
                identifier = lDigest(fGetHwid())
            }),
            Headers = {
                ["Content-Type"] = "application/json"
            }
        });

        if response.StatusCode == 200 then
            local decoded = lDecode(response.Body);

            if decoded.success == true then
                cachedLink = decoded.data.url;
                cachedTime = fOsTime();
                return true, cachedLink;
            else
                onMessage(decoded.message);
                return false, decoded.message;
            end
        elseif response.StatusCode == 429 then
            local msg = "you are being rate limited, please wait 20 seconds and try again.";
            onMessage(msg);
            return false, msg;
        end

        local msg = "Failed to cache link.";
        onMessage(msg);
        return false, msg;
    else
        return true, cachedLink;
    end
end

pcall(cacheLink);


local generateNonce = function()
    local str = ""
    for _ = 1, 16 do
        str = str .. fStringChar(fMathFloor(fMathRandom() * (122 - 97 + 1)) + 97)
    end
    return str
end


for _ = 1, 5 do
    local oNonce = generateNonce();
    task.wait(0.2)
    if generateNonce() == oNonce then
        local msg = "platoboost nonce error.";
        onMessage(msg);
        error(msg);
    end
end


local copyLink = function()
    local success, link = cacheLink();

    if success then
        fSetClipboard(link);
    end
end


local redeemKey = function(key)
    local nonce = generateNonce();
    local endpoint = host .. "/public/redeem/" .. fToString(service);

    local body = {
        identifier = lDigest(fGetHwid()),
        key = key
    }

    if useNonce then
        body.nonce = nonce;
    end

    local response = fRequest({
        Url = endpoint,
        Method = "POST",
        Body = lEncode(body),
        Headers = {
            ["Content-Type"] = "application/json"
        }
    });

    if response.StatusCode == 200 then
        local decoded = lDecode(response.Body);

        if decoded.success == true then
            if decoded.data.valid == true then
                if useNonce then
                    if decoded.data.hash == lDigest("true" .. "-" .. nonce .. "-" .. secret) then
                        return true;
                    else
                        onMessage("failed to verify integrity.");
                        return false;
                    end
                else
                    return true;
                end
            else
                onMessage("key is invalid.");
                return false;
            end
        else
            if fStringSub(decoded.message, 1, 27) == "unique constraint violation" then
                onMessage("you already have an active key, please wait for it to expire before redeeming it.");
                return false;
            else
                onMessage(decoded.message);
                return false;
            end
        end
    elseif response.StatusCode == 429 then
        onMessage("you are being rate limited, please wait 20 seconds and try again.");
        return false;
    else
        onMessage("server returned an invalid status code, please try again later.");
        return false;
    end
end


local verifyKey = function(key)
    if requestSending == true then
        onMessage("a request is already being sent, please slow down.");
        return false;
    else
        requestSending = true;
    end

    local nonce = generateNonce();
    local endpoint = host .. "/public/whitelist/" .. fToString(service) .. "?identifier=" .. lDigest(fGetHwid()) .. "&key=" .. key;

    if useNonce then
        endpoint = endpoint .. "&nonce=" .. nonce;
    end

    local response = fRequest({
        Url = endpoint,
        Method = "GET",
    });

    requestSending = false;

    if response.StatusCode == 200 then
        local decoded = lDecode(response.Body);

        if decoded.success == true then
            if decoded.data.valid == true then
                if useNonce then
                    if decoded.data.hash == lDigest("true" .. "-" .. nonce .. "-" .. secret) then
                        return true;
                    else
                        onMessage("failed to verify integrity.");
                        return false;
                    end
                else
                    return true;
                end
            else
                if fStringSub(key, 1, 4) == "KEY_" then
                    return redeemKey(key);
                else
                    onMessage("key is invalid.");
                    return false;
                end
            end
        else
            onMessage(decoded.message);
            return false;
        end
    elseif response.StatusCode == 429 then
        onMessage("you are being rate limited, please wait 20 seconds and try again.");
        return false;
    else
        onMessage("server returned an invalid status code, please try again later.");
        return false;
    end
end


local getFlag = function(name)
    local nonce = generateNonce();
    local endpoint = host .. "/public/flag/" .. fToString(service) .. "?name=" .. name;

    if useNonce then
        endpoint = endpoint .. "&nonce=" .. nonce;
    end

    local response = fRequest({
        Url = endpoint,
        Method = "GET",
    });

    if response.StatusCode == 200 then
        local decoded = lDecode(response.Body);

        if decoded.success == true then
            if useNonce then
                if decoded.data.hash == lDigest(fToString(decoded.data.value) .. "-" .. nonce .. "-" .. secret) then
                    return decoded.data.value;
                else
                    onMessage("failed to verify integrity.");
                    return nil;
                end
            else
                return decoded.data.value;
            end
        else
            onMessage(decoded.message);
            return nil;
        end
    else
        return nil;
    end
end














local function boot()

    local function httpGet(url)

        if type(request) == "function" then
            local ok, res = pcall(function()
                return request({ Url = url, Method = "GET" }).Body
            end)
            if ok and type(res) == "string" and #res > 0 then return res end
        end
        if type(game.HttpGet) == "function" then
            local ok, res = pcall(function() return game:HttpGet(url) end)
            if ok and type(res) == "string" and #res > 0 then return res end
        end
        return nil
    end

    local Rayfield
    local src = httpGet("https://sirius.menu/gen2")
    if src then
        local chunk = loadstring(src)
        if chunk then
            local ok, lib = pcall(chunk)
            if ok and type(lib) == "table" and lib.CreateWindow then Rayfield = lib end
        end
    end
    if not Rayfield then
        getgenv().AsylumError = "Rayfield Gen2 failed to load"
        warn("[Asylum] " .. getgenv().AsylumError)
        return
    end

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer

    local KEY = { enabled = true, cacheDir = "asylum", cacheFile = "key.txt" }
    local function keyCachePath() return KEY.cacheDir .. "/" .. KEY.cacheFile end
    local function readCachedKey()
        local ok, data = pcall(function() return readfile(keyCachePath()) end)
        if ok and type(data) == "string" then
            data = string.gsub(data, "%s+$", "")
            if #data > 0 then return data end
        end
        return nil
    end
    local function validateKey(key)
        if key == nil or #tostring(key) == 0 then return false end
        if type(verifyKey) ~= "function" then return nil end
        local ok, verdict = pcall(verifyKey, tostring(key))
        if not ok then return nil end
        return verdict == true
    end

    local function keyGate()
        if not KEY.enabled then return true end
        if type(verifyKey) ~= "function" then return true end
        local cached = readCachedKey()
        if cached and validateKey(cached) == true then return true end

        local gateWindow = Rayfield:CreateWindow({
            name = "Asylum",
            subtitle = "Authentication",
            sidebarLayout = false,
            configuration = { autoSave = false, autoLoad = false },
        })
        local tab = gateWindow:CreateTab({ name = "Key" })

        tab:CreateText({
            name = "Access required",
            text = "Paste your key and press Validate. Use Get key if you need one.",
        })

        local pending = ""
        tab:CreateInput({
            name = "Key",
            placeholder = "paste your key",
            removeTextAfterFocusLost = false,
            callback = function(text) pending = tostring(text) end,
        })

        local statusLine = tab:CreateText({ name = "Status", text = " " })
        local done, accepted = false, false

        tab:CreateButton({
            name = "Validate",
            callback = function()
                if done then return end
                pcall(function() statusLine:Set("checking...") end)
                task.spawn(function()
                    local verdict = validateKey(pending)
                    if verdict == true then
                        pcall(function()
                            if type(isfolder) == "function" and not isfolder(KEY.cacheDir) then
                                makefolder(KEY.cacheDir)
                            end
                            writefile(keyCachePath(), pending)
                        end)
                        pcall(function() statusLine:Set("accepted - loading") end)
                        accepted, done = true, true
                    elseif verdict == false then
                        pcall(function() statusLine:Set("key rejected") end)
                    else
                        pcall(function() statusLine:Set("could not reach the server") end)
                    end
                end)
            end,
        })

        tab:CreateButton({
            name = "Get key",
            callback = function()
                local ok = pcall(copyLink)
                pcall(function()
                    statusLine:Set(ok and "link copied to clipboard" or "could not get link")
                end)
            end,
        })

        tab:CreateButton({
            name = "Close",
            callback = function()
                done = true
                accepted = false
                pcall(function() gateWindow:Unload() end)
            end,
        })

        while not done do task.wait(0.1) end
        pcall(function() gateWindow:Unload() end)
        return accepted
    end

    if not keyGate() then
        getgenv().AsylumError = "key rejected"
        return
    end

