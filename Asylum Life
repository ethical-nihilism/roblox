            end)
        end
        pcall(function() Window:Unload() end)
        getgenv().Asylum = nil
    end

    getgenv().Asylum = {
        aim = aim,
        esp = esp,
        GetStats = function()
            return {
                hookInstalled = hookInstalled,
                espEnabled = esp.enabled,
                useTag = esp.useTag,
                taggedLabels = esp.tagged,
                hostileTeams = (function()
                    local t = {}
                    for k, v in pairs(esp.hostileTeams) do if v then t[#t + 1] = k end end
                    return t
                end)(),
                aim = {
                    enabled = aim.enabled,
                    rifle = aim.rifle,
                    taser = aim.taser,
                    part = aim.part,
                    rifleShotsSeen = aim.reads.rifle,
                    taserShotsSeen = aim.reads.taser,
                    rifleRewrites = aim.rifleRewrites,
                    taserRewrites = aim.taserRewrites,
                    finds = aim.finds,
                    blocked = aim.blocked,
                },
            }
        end,
        SetSilentAim = function(v)
            aim.enabled = v and true or false

            if aimToggle then pcall(function() aimToggle:Set(aim.enabled, true) end) end
        end,
        SetHostileTeams = function(list)
            esp.hostileTeams = {}
            for _, name in ipairs(list or {}) do esp.hostileTeams[name] = true end
        end,
        RefreshTags = function() refreshHostileLabels() end,
        Pumpkins = pumpkins,

        DebugHostiles = function()

            local function parentState(l)
                local p = l.Parent
                if not p then return "noParent" end
                if p:IsA("LayerCollector") then return p.ClassName .. ":enabled=" .. tostring(p.Enabled) end
                if p:IsA("GuiObject") then return p.ClassName .. ":vis=" .. tostring(p.Visible) end
                return p.ClassName
            end
            local rows = {}
            for player, list in pairs(hostileLabels) do
                if isHostile(player) then
                    local details = {}
                    for i = 1, #list do
                        local l = list[i]
                        details[#details + 1] = string.format("%s=(%s)", l.Name,
                            parentState(l))
                    end
                    rows[#rows + 1] = string.format("%s(%d) [%s]", player.Name, #list,
                        table.concat(details, " ; "))
                end
            end
            table.sort(rows)
            return rows
        end,
        AimTarget = function()
            local t = aimTarget()
            return t and (t:GetFullName() .. " [" .. t.ClassName .. "]") or nil
        end,
        Unload = function() unload() end,
    }

    getgenv().AsylumError = nil
    print("[Asylum] loaded. fire hook=" .. tostring(hookInstalled))
    return getgenv().Asylum
end

local ok, err = pcall(boot)
if not ok then
    getgenv().AsylumError = tostring(err)
    warn("[Asylum] " .. tostring(err))
end
return ok
