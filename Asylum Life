--[[
    Asylum Life (place 132352755769957)
    Hostile ESP + pumpkin ESP + Taser / Taser Rifle silent aim
    UI: Rayfield Gen2

    Fire is client-authored on two paths:
      RifleFireEvent  FireServer(<unit Vector3 direction>)
      TaserEvent      InvokeServer("Tase", <hit BasePart>)
    The rifle's direction is rewritten; the taser's hit part is rewritten.

    getgenv().Asylum: GetStats / SetSilentAim / SetHostileTeams / AimTarget / Unload
]]

local function boot()
    ------------------------------------------------------------------
    -- 0. UI library
    ------------------------------------------------------------------
    local function httpGet(url)
        -- request() first: game:HttpGet was observed hanging forever in this
        -- executor, and a hang is not catchable with pcall.
        if type(request) == "function" then
            local ok, res = pcall(function()
                return request({ Url = url, Method = "GET" }).Body
            end)
            if ok and type(res) == "string" and #res > 0 then return res end
        end
        if type(game.HttpGet) == "function" then
            local ok, res = pcall(function() return game:HttpGet(url) end)
            if ok and type(res) == "string" and #res > 0 then return res end
        end
        return nil
    end

    local Rayfield
    local src = httpGet("https://sirius.menu/gen2")
    if src then
        local chunk = loadstring(src)
        if chunk then
            local ok, lib = pcall(chunk)
            if ok and type(lib) == "table" and lib.CreateWindow then Rayfield = lib end
        end
    end
    if not Rayfield then
        getgenv().AsylumError = "Rayfield Gen2 failed to load"
        warn("[Asylum] " .. getgenv().AsylumError)
        return
    end

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer
    ------------------------------------------------------------------
    -- 0b. Key system (Platoboost). Driver is prepended at the top of this file.
    -- The gate reuses Rayfield so it matches the main menu instead of hand-rolled
    -- frames.
    ------------------------------------------------------------------
    local KEY = { enabled = true, cacheDir = "asylum", cacheFile = "key.txt" }
    local function keyCachePath() return KEY.cacheDir .. "/" .. KEY.cacheFile end
    local function readCachedKey()
        local ok, data = pcall(function() return readfile(keyCachePath()) end)
        if ok and type(data) == "string" then
            data = string.gsub(data, "%s+$", "")
            if #data > 0 then return data end
        end
        return nil
    end
    local function validateKey(key)
        if key == nil or #tostring(key) == 0 then return false end
        if type(verifyKey) ~= "function" then return nil end
        local ok, verdict = pcall(verifyKey, tostring(key))
        if not ok then return nil end
        return verdict == true
    end

    local function keyGate()
        if not KEY.enabled then return true end
        if type(verifyKey) ~= "function" then return true end
        local cached = readCachedKey()
        if cached and validateKey(cached) == true then return true end

        local gateWindow = Rayfield:CreateWindow({
            name = "Asylum",
            subtitle = "Authentication",
            sidebarLayout = false,
            configuration = { autoSave = false, autoLoad = false },
        })
        local tab = gateWindow:CreateTab({ name = "Key" })

        tab:CreateText({
            name = "Access required",
            text = "Paste your key and press Validate. Use Get key if you need one.",
        })

        local pending = ""
        tab:CreateInput({
            name = "Key",
            placeholder = "paste your key",
            removeTextAfterFocusLost = false,
            callback = function(text) pending = tostring(text) end,
        })

        local statusLine = tab:CreateText({ name = "Status", text = " " })
        local done, accepted = false, false

        tab:CreateButton({
            name = "Validate",
            callback = function()
                if done then return end
                pcall(function() statusLine:Set("checking...") end)
                task.spawn(function()
                    local verdict = validateKey(pending)
                    if verdict == true then
                        pcall(function()
                            if type(isfolder) == "function" and not isfolder(KEY.cacheDir) then
                                makefolder(KEY.cacheDir)
                            end
                            writefile(keyCachePath(), pending)
                        end)
                        pcall(function() statusLine:Set("accepted - loading") end)
                        accepted, done = true, true
                    elseif verdict == false then
                        pcall(function() statusLine:Set("key rejected") end)
                    else
                        pcall(function() statusLine:Set("could not reach the server") end)
                    end
                end)
            end,
        })

        tab:CreateButton({
            name = "Get key",
            callback = function()
                local ok = pcall(copyLink)
                pcall(function()
                    statusLine:Set(ok and "link copied to clipboard" or "could not get link")
                end)
            end,
        })

        tab:CreateButton({
            name = "Close",
            callback = function()
                done = true
                accepted = false
                pcall(function() gateWindow:Unload() end)
            end,
        })

        while not done do task.wait(0.1) end
        pcall(function() gateWindow:Unload() end)
        return accepted
    end

    if not keyGate() then
        getgenv().AsylumError = "key rejected"
        return
    end
    ------------------------------------------------------------------
    -- 1. State (declared BEFORE the hook, which closes over it)
    ------------------------------------------------------------------
    local aim = {
        enabled = false,
        rifle = true,             -- Taser Rifle: rewrite the fire direction
        taser = true,             -- Taser: rewrite the reported hit part
        part = "Head",
        -- Target selection cone. Kept near the measured turn limit so the selector
        -- only offers targets the rewrite can actually reach.
        fov = 80,
        maxDistance = 900,
        -- The server rejects implausible shots. Rewriting the direction to point
        -- directly at a target deviated by 60+ degrees from the original, and the
        -- Taser Rifle then stopped working entirely. So the rewrite is clamped to
        -- at most maxAngle away from what the client already aimed at: a nudge
        -- rather than a hard turn. 180 = uncapped (known to break the weapon).
        -- MEASURED LIMIT: a turn of ~21.7 deg landed on target, a deliberate ~40 deg
        -- did not, and the working ceiling is about 35 deg. Above that the shot is
        -- discarded, so the direction is only accepted within roughly a 35 deg cone
        -- of where the client was actually aiming. Default sits below the ceiling on
        -- purpose: this is a bounded correction, not an arbitrary-angle silent aim.
        maxAngle = 30,
        measuredLimit = 35,
        lastAngle = 0,
        -- Precomputed target. The hook MUST NOT perform any namecall of its own:
        -- doing so overwrites getnamecallmethod(), and the re-issue below then runs
        -- the WRONG method. That is exactly what produced
        --   "argument #1 expects a string, but Vector3 was passed"
        -- (FindFirstChild(name) receiving a Vector3) and why the Taser Rifle went
        -- dead whenever silent aim was on. Everything is resolved here instead, on
        -- a normal Heartbeat, and the hook only reads these plain values.
        cachedTarget = nil,
        cachedTargetPos = nil,
        cachedOrigin = nil,
        -- Taser hit-test redirect. The taser never sends a direction: it raycasts
        -- locally and then REPORTS the part it already hit, so rewriting the report
        -- cannot create a hit that never happened. Measured hit-test traffic here is
        -- FindPartOnRayWithIgnoreList x7669 / Raycast x2337, so the correction has to
        -- happen on the ray itself, inside a short window after the tool activates.
        taserWindow = 0,
        taserTool = nil,
        taserConn = nil,
        taserRayRewrites = 0,
        wallCheck = false,        -- off by default: costs a raycast per candidate
        blocked = 0,
        visibilityCache = {},
        rifleRewrites = 0,
        taserRewrites = 0,
        finds = 0,
        reads = { rifle = 0, taser = 0 },
    }

    local esp = {
        enabled = true,
        highlight = true,
        name = true,
        distance = true,
        health = true,
        -- useTag = read the game's own "Hostile" nameplate (correct).
        -- hostileTeams is only the fallback when useTag is off.
        useTag = true,
        tagged = 0,
        hostileTeams = { PATIENT = true, CHOOSING = true },
        maxDistance = 2000,
        fillTransparency = 0.75,
    }

    local cache = {}

    -- Reload safety. unload() used to restore the namecall hook but never
    -- disconnect the Heartbeat loops, so every reload left another live ESP writer
    -- behind: the folder showed 20 highlights while only 5 players were hostile,
    -- because orphaned loops were still painting the old team-based set. Track the
    -- connections, and publish a generation so any orphan goes inert immediately.
    local connections = {}
    local generation = (getgenv().AsylumGeneration or 0) + 1
    getgenv().AsylumGeneration = generation

    local function track(conn)
        connections[#connections + 1] = conn
        return conn
    end

    ------------------------------------------------------------------
    -- 2. Target selection
    ------------------------------------------------------------------
    -- Hostility comes from the GAME, not from teams.
    --
    -- A team list is simply wrong here: a PATIENT is only hostile while wanted.
    -- Asylum Life marks wanted players by rendering a BillboardGui label named
    -- exactly "Hostile" above them and toggling its visibility. Measured in a
    -- live server: 39 such labels in PlayerGui, every one adorneed to
    -- Workspace.Characters.<name>.Torso, and Visible=false for non-hostiles.
    -- Reading that tag is the only correct source.
    local hostileLabels = {}

    local function labelVisible(lbl)
        if not lbl or not lbl.Parent then return false end
        if lbl.TextTransparency >= 0.95 then return false end
        local node = lbl
        while node and node ~= game do
            if node:IsA("GuiObject") and not node.Visible then return false end
            if node:IsA("LayerCollector") then return node.Enabled end
            node = node.Parent
        end
        return true
    end

    local function refreshHostileLabels()
        local gui = LocalPlayer:FindFirstChild("PlayerGui")
        if not gui then return end
        -- A player can own SEVERAL labels containing "hostile" (live one plus hidden
        -- duplicates). Keeping only the last one seen made the visibility test read
        -- the wrong instance, which over-reported hostiles: 21 highlighted against 6
        -- actually wanted. So keep them all and treat "any visible" as hostile.
        local map = {}
        for _, d in ipairs(gui:GetDescendants()) do
            if d:IsA("TextLabel") and d.Text
                and string.find(string.lower(d.Text), "hostile") then
                local bb = d:FindFirstAncestorOfClass("BillboardGui")
                local adornee = bb and bb.Adornee
                if adornee then
                    local char = adornee:FindFirstAncestorOfClass("Model")
                    if not char and adornee:IsA("Model") then char = adornee end
                    local player = char and Players:GetPlayerFromCharacter(char)
                    if player then
                        local list = map[player]
                        if not list then
                            list = {}
                            map[player] = list
                        end
                        list[#list + 1] = d
                    end
                end
            end
        end
        hostileLabels = map
        esp.tagged = 0
        for _ in pairs(map) do esp.tagged = esp.tagged + 1 end
    end

    local function isHostile(player)
        if player == LocalPlayer then return false end
        if esp.useTag then
            local list = hostileLabels[player]
            if not list then return false end
            for i = 1, #list do
                if labelVisible(list[i]) then return true end
            end
            return false
        end
        local team = player.Team and player.Team.Name or ""
        return esp.hostileTeams[team] == true
    end

    local rayParams = RaycastParams.new()
    pcall(function() rayParams.FilterType = Enum.RaycastFilterType.Exclude end)
    pcall(function() rayParams.FilterType = Enum.RaycastFilterType.Blacklist end)
    rayParams.IgnoreWater = true
    pcall(function() rayParams.RespectCanCollide = true end)

    local function canSee(part, char)
        local cam = workspace.CurrentCamera
        if not cam then return false end
        local origin = cam.CFrame.Position
        local direction = part.Position - origin
        if direction.Magnitude <= 0 then return false end
        local filter = { char }
        local myChar = LocalPlayer.Character
        if myChar then filter[#filter + 1] = myChar end
        rayParams.FilterDescendantsInstances = filter
        aim.internalRay = true
        local ok, result = pcall(function()
            return workspace:Raycast(origin, direction, rayParams)
        end)
        aim.internalRay = nil
        if not ok then return false end
        return result == nil
    end

    local function canSeeCached(part, char)
        local now = os.clock()
        local hit = aim.visibilityCache[part]
        if hit and now - hit.t < 0.12 then return hit.visible end
        local visible = canSee(part, char)
        aim.visibilityCache[part] = { t = now, visible = visible }
        return visible
    end

    local function aimTarget()
        local cam = workspace.CurrentCamera
        if not cam then return nil end
        local origin = cam.CFrame.Position
        local look = cam.CFrame.LookVector

        local best, bestScore = nil, nil
        for _, player in ipairs(Players:GetPlayers()) do
            if isHostile(player) then
                local char = player.Character
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                local part = char and (char:FindFirstChild(aim.part)
                    or char:FindFirstChild("HumanoidRootPart"))
                if part and humanoid and humanoid.Health > 0 then
                    local to = part.Position - origin
                    local dist = to.Magnitude
                    if dist > 0 and dist <= aim.maxDistance then
                        local angle = math.deg(math.acos(math.clamp(look:Dot(to.Unit), -1, 1)))
                        if angle <= aim.fov / 2 then
                            local visible = true
                            if aim.wallCheck then
                                visible = canSeeCached(part, char)
                                if not visible then aim.blocked = aim.blocked + 1 end
                            end
                            if visible then
                                local score = angle + dist * 0.02
                                if not bestScore or score < bestScore then
                                    best, bestScore = part, score
                                end
                            end
                        end
                    end
                end
            end
        end
        if best then aim.finds = aim.finds + 1 end
        return best
    end

    ------------------------------------------------------------------
    -- 3. Fire hook
    --
    -- Both remotes are matched by name substring, not by hardcoded instance, so a
    -- reconnect does not break it. Neither path allocates anything until it is
    -- about to rewrite a shot.
    ------------------------------------------------------------------
    -- Argument surgery helpers.
    --
    -- The first version of this hook rebuilt the call as original(self, newVector),
    -- which is only safe when the payload is exactly one value. Measured shapes are:
    --   RifleFireEvent  FireServer(<Vector3>)               -> 1 arg
    --   TaserEvent      FireServer("Tase", <BasePart>)       -> 2 args
    -- so the rewrite must replace ONE slot and re-emit every other argument
    -- untouched. Replacing by slot also means the argument types can never shift,
    -- which is what produced "argument #1 expects a string, but Vector3 was passed".
    local function replaceSlot(args, index, value)
        local copy = {}
        for i = 1, #args do copy[i] = args[i] end
        copy[index] = value
        return table.unpack(copy, 1, #args)
    end

    -- Every helper below must be NAMECALL-FREE.
    --
    -- vector:Dot(), vector:Cross() and instance:IsA() are all namecalls. Running any
    -- of them inside the hook overwrites getnamecallmethod() before the re-issue, so
    -- the original call is dispatched as the WRONG method. That single bug broke
    -- both weapons: the rifle via Dot/Cross in the angle clamp, and the taser via
    -- IsA in the argument scan. Plain arithmetic and typeof() only from here on.
    local function dot3(a, b)
        return a.X * b.X + a.Y * b.Y + a.Z * b.Z
    end

    local function cross3(a, b)
        return Vector3.new(
            a.Y * b.Z - a.Z * b.Y,
            a.Z * b.X - a.X * b.Z,
            a.X * b.Y - a.Y * b.X)
    end

    local function firstVector3Index(args)
        for i = 1, #args do
            if typeof(args[i]) == "Vector3" then return i end
        end
        return nil
    end

    -- The taser payload is ("Tase", <hit BasePart>), so the single Instance argument
    -- is the hit part. Identifying it by typeof avoids a class check entirely.
    local function firstInstanceIndex(args)
        for i = 1, #args do
            if typeof(args[i]) == "Instance" then return i end
        end
        return nil
    end

    -- Rotate `original` toward `desired`, by at most maxAngle degrees.
    local function clampDirection(original, desired, maxAngle)
        local dot = math.clamp(dot3(original, desired), -1, 1)
        local angle = math.deg(math.acos(dot))
        if maxAngle >= 180 or angle <= maxAngle then return desired, angle end
        local axis = cross3(original, desired)
        if axis.Magnitude < 0.000001 then return desired, angle end
        return CFrame.fromAxisAngle(axis.Unit, math.rad(maxAngle)) * original, maxAngle
    end

    local original = nil
    -- Ray methods the taser's local hit test can go through. Redirecting one of
    -- these inside the activation window makes the CLIENT believe it hit the target,
    -- and then the game reports ("Tase", targetHead) on its own.
    local TASE_RAY_METHODS = {
        FindPartOnRayWithIgnoreList = true,
        FindPartOnRayWithWhitelist = true,
        FindPartOnRay = true,
        Raycast = true,
    }
    local okHook = pcall(function()
        original = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()

            -- Taser hit-test redirect. The window is 0 unless a taser just fired, so
            -- the normal path costs one number compare. Namecall-free: typeof,
            -- property reads and Ray.new only.
            if aim.taserWindow > 0 and TASE_RAY_METHODS[method]
                and aim.taser and aim.cachedTargetPos then
                local args = { ... }
                local first = args[1]
                if method == "Raycast" then
                    if typeof(first) == "Vector3" and typeof(args[2]) == "Vector3" then
                        local to = aim.cachedTargetPos - first
                        if to.Magnitude > 0 then
                            aim.taserRayRewrites = aim.taserRayRewrites + 1
                            return original(self, replaceSlot(args, 2, to.Unit * args[2].Magnitude))
                        end
                    end
                elseif typeof(first) == "Ray" then
                    local to = aim.cachedTargetPos - first.Origin
                    if to.Magnitude > 0 then
                        aim.taserRayRewrites = aim.taserRayRewrites + 1
                        return original(self, replaceSlot(args, 1,
                            Ray.new(first.Origin, to.Unit * first.Direction.Magnitude)))
                    end
                end
                return original(self, ...)
            end

            if method ~= "FireServer" and method ~= "InvokeServer" then
                return original(self, ...)
            end
            if aim.internalRay then
                return original(self, ...)
            end
            if typeof(self) ~= "Instance" or not aim.enabled then
                return original(self, ...)
            end

            -- Taser Rifle -----------------------------------------------------
            -- Payload: FireServer(<unit Vector3 direction>), authored by the client.
            --
            -- KNOWN LIMITATIONS (measured, not guessed):
            --  1) Hard ceiling of about 35 deg of turn. A larger correction gets the
            --     shot discarded server-side, which feels like "the rifle stopped
            --     working". maxAngle therefore defaults to 30, not 180.
            --  2) It is a cone correction, not free silent aim: the crosshair must
            --     already be roughly on the target. It cannot pull a shot from behind.
            --  3) Fragile to game updates: matched by exact name "RifleFireEvent" and
            --     by locating a single Vector3 in the args. If the payload gains fields
            --     or the remote is renamed, the rewrite silently stops and every shot
            --     goes straight.
            --  4) NOTHING in this branch may touch an Instance (see cachedTarget):
            --     any namecall here changes getnamecallmethod() and the re-issue
            --     dispatches the WRONG method, which breaks the rifle completely.
            if aim.rifle and self.Name == "RifleFireEvent" then
                local args = { ... }
                local index = firstVector3Index(args)
                if index then
                    aim.reads.rifle = aim.reads.rifle + 1
                    local targetPos = aim.cachedTargetPos
                    local origin = aim.cachedOrigin
                    if targetPos and origin then
                        local to = targetPos - origin
                        if to.Magnitude > 0 then
                            aim.rifleRewrites = aim.rifleRewrites + 1
                            local newDir, angle = clampDirection(args[index], to.Unit, aim.maxAngle)
                            aim.lastAngle = angle
                            aim.lastPayload = string.format(
                                "rifle slot#%d  angle=%.1f deg  %s -> %s",
                                index, angle, tostring(args[index]), tostring(newDir))
                            return original(self, replaceSlot(args, index, newDir))
                        end
                    end
                end
                return original(self, ...)
            end

            -- Taser: exact name match; swap only the reported hit BasePart.
            if aim.taser and self.Name == "TaserEvent" then
                local args = { ... }
                local index = firstInstanceIndex(args)
                if index then
                    aim.reads.taser = aim.reads.taser + 1
                    local target = aim.cachedTarget
                    if target then
                        aim.taserRewrites = aim.taserRewrites + 1
                        aim.lastPayload = "taser slot#" .. index .. " -> " .. tostring(target)
                        return original(self, replaceSlot(args, index, target))
                    end
                end
                return original(self, ...)
            end

            return original(self, ...)
        end))
    end)
    local hookInstalled = okHook and original ~= nil

    -- Resolve the target OUT here, where namecalls are harmless. The hook then only
    -- reads these fields, so its own call frame never performs a namecall and
    -- getnamecallmethod() still says "FireServer" when it re-issues the call.
    track(RunService.Heartbeat:Connect(function()
        if getgenv().AsylumGeneration ~= generation then return end
        if not aim.enabled then
            aim.cachedTarget, aim.cachedTargetPos, aim.cachedOrigin = nil, nil, nil
            return
        end
        local cam = workspace.CurrentCamera
        aim.cachedOrigin = cam and cam.CFrame.Position or nil
        local target = aimTarget()
        aim.cachedTarget = target
        aim.cachedTargetPos = target and target.Position or nil
    end))

    -- Open the taser redirect window. Two triggers, because a tool may report via
    -- Activated or may drive itself straight off the mouse button.
    local UserInputService = game:GetService("UserInputService")
    local function openTaserWindow()
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool and string.find(string.lower(tool.Name), "taser", 1, true) then
            aim.taserWindow = os.clock() + 0.25
        end
    end

    track(RunService.Heartbeat:Connect(function()
        if getgenv().AsylumGeneration ~= generation then return end
        if aim.taserWindow > 0 and os.clock() > aim.taserWindow then aim.taserWindow = 0 end
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if not (tool and string.find(string.lower(tool.Name), "taser", 1, true)) then
            if aim.taserConn then
                pcall(function() aim.taserConn:Disconnect() end)
                aim.taserConn, aim.taserTool = nil, nil
            end
            return
        end
        if aim.taserTool ~= tool then
            if aim.taserConn then pcall(function() aim.taserConn:Disconnect() end) end
            aim.taserTool = tool
            aim.taserConn = tool.Activated:Connect(function()
                if getgenv().AsylumGeneration == generation then
                    aim.taserWindow = os.clock() + 0.25
                end
            end)
        end
    end))

    track(UserInputService.InputBegan:Connect(function(input, processed)
        if processed or getgenv().AsylumGeneration ~= generation then return end
        if not (aim.enabled and aim.taser) then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            openTaserWindow()
        end
    end))

    ------------------------------------------------------------------
    -- 4. ESP
    ------------------------------------------------------------------
    local function container()
        local parent = (gethui and gethui()) or game:GetService("CoreGui")
        local folder = parent:FindFirstChild("Asylum_ESP_Folder")
        if not folder then
            folder = Instance.new("Folder")
            folder.Name = "Asylum_ESP_Folder"
            folder.Parent = parent
        end
        return folder
    end

    local function makeEntry(player)
        local folder = container()
        local highlight = Instance.new("Highlight")
        highlight.Name = player.Name
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = Color3.fromRGB(255, 60, 60)
        highlight.OutlineColor = Color3.fromRGB(255, 140, 140)
        highlight.Parent = folder

        local billboard = Instance.new("BillboardGui")
        billboard.Name = player.Name
        billboard.Size = UDim2.new(0, 220, 0, 38)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = folder

        local text = Instance.new("TextLabel")
        text.Size = UDim2.new(1, 0, 1, 0)
        text.BackgroundTransparency = 1
        text.Font = Enum.Font.GothamBold
        text.TextSize = 13
        text.TextStrokeTransparency = 0.25
        text.TextColor3 = Color3.fromRGB(255, 120, 120)
        text.Parent = billboard

        local entry = { highlight = highlight, billboard = billboard, text = text }
        cache[player] = entry
        return entry
    end

    local function dropEntry(player)
        local entry = cache[player]
        if not entry then return end
        pcall(function() entry.highlight:Destroy() end)
        pcall(function() entry.billboard:Destroy() end)
        cache[player] = nil
    end

    local function healthColor(health, maxHealth)
        local ratio = math.clamp(maxHealth > 0 and health / maxHealth or 0, 0, 1)
        local r = ratio < 0.5 and 255 or math.floor(255 - (ratio * 2 - 1) * 255)
        local g = ratio > 0.5 and 255 or math.floor(ratio * 2 * 255)
        return Color3.fromRGB(r, g, 0)
    end

    -- Hostiles are always red. Team colour only applies to non-hostiles.
    local function teamColor(player)
        if isHostile(player) then return Color3.fromRGB(255, 60, 60) end
        local ok, brickColor = pcall(function() return player.TeamColor end)
        if ok and brickColor then
            local okColor, color = pcall(function() return brickColor.Color end)
            if okColor and color then return color end
        end
        return Color3.fromRGB(255, 60, 60)
    end

    track(RunService.Heartbeat:Connect(function()
        if getgenv().AsylumGeneration ~= generation then return end
        if not esp.enabled then
            for player in pairs(cache) do dropEntry(player) end
            return
        end

        -- The game can rebuild a nameplate at any time, so re-map them about once a
        -- second. isHostile() itself stays a cheap lookup + visibility walk.
        esp.tick = (esp.tick or 0) + 1
        if esp.useTag and esp.tick % 60 == 0 then refreshHostileLabels() end
        if esp.tick == 1 and esp.useTag then refreshHostileLabels() end

        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end

            local hostile = isHostile(player)
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")

            local visible = hostile and char and hrp and head and humanoid
                and humanoid.Health > 0

            local dist = 0
            if visible and myHrp then
                dist = math.floor((myHrp.Position - hrp.Position).Magnitude)
                if dist > esp.maxDistance then visible = false end
            end

            if not visible then
                dropEntry(player)
                continue
            end

            local entry = cache[player] or makeEntry(player)
            local color = teamColor(player)

            entry.highlight.Enabled = esp.highlight
            if esp.highlight then
                entry.highlight.Adornee = char
                entry.highlight.FillColor = color
                entry.highlight.OutlineColor = color:Lerp(Color3.new(1, 1, 1), 0.45)
                entry.highlight.FillTransparency = esp.fillTransparency
            end

            local show = esp.name or esp.distance or esp.health
            entry.billboard.Enabled = show
            if show then
                entry.billboard.Adornee = head
                local chunks = {}
                if esp.name then chunks[#chunks + 1] = player.Name end
                if esp.distance then chunks[#chunks + 1] = "[" .. dist .. "m]" end
                if esp.health then
                    chunks[#chunks + 1] = "[" .. math.floor(humanoid.Health) .. " HP]"
                    entry.text.TextColor3 = healthColor(humanoid.Health, humanoid.MaxHealth)
                else
                    entry.text.TextColor3 = color
                end
                entry.text.Text = table.concat(chunks, " ")
            end
        end
    end))

    track(Players.PlayerRemoving:Connect(function(player) dropEntry(player) end))

    ------------------------------------------------------------------
    -- 3b. Pumpkin ESP
    --
    -- The scavenger-hunt pumpkins are ordinary Models under one Workspace folder:
    --   Workspace.ScavengerHunt.ScavengerPumpkin1 .. 20   [Model]
    -- each with a MeshPart PrimaryPart of roughly 3.5 x 2.4 x 3.5 studs. They are
    -- not players and they can be collected, so they get their own sync pass keyed
    -- by Model rather than going through the player ESP above.
    ------------------------------------------------------------------
    local pumpkins = {
        enabled = true,
        label = true,
        maxDistance = 3000,
        fillTransparency = 0.25,
        color = Color3.fromRGB(255, 150, 0),
        cache = {},
    }

    local function pumpkinAnchor(model)
        return model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    end

    track(RunService.Heartbeat:Connect(function()
        if getgenv().AsylumGeneration ~= generation then return end

        local folder = workspace:FindFirstChild("ScavengerHunt")
        local alive = {}
        if folder then
            for _, model in ipairs(folder:GetChildren()) do
                if model:IsA("Model") then alive[model] = true end
            end
        end

        -- drop entries for pumpkins that were collected or despawned
        for model, entry in pairs(pumpkins.cache) do
            if not alive[model] then
                pcall(function() entry.highlight:Destroy() end)
                pcall(function() entry.billboard:Destroy() end)
                pumpkins.cache[model] = nil
            end
        end

        if not pumpkins.enabled then
            for _, entry in pairs(pumpkins.cache) do
                entry.highlight.Enabled = false
                entry.billboard.Enabled = false
            end
            return
        end

        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")

        for model in pairs(alive) do
            local anchor = pumpkinAnchor(model)
            if anchor then
                local entry = pumpkins.cache[model]
                if not entry then
                    local highlight = Instance.new("Highlight")
                    highlight.Name = model.Name
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.FillColor = pumpkins.color
                    highlight.OutlineColor = Color3.fromRGB(255, 220, 150)
                    highlight.Parent = container()

                    local billboard = Instance.new("BillboardGui")
                    billboard.Name = model.Name
                    billboard.Size = UDim2.new(0, 160, 0, 22)
                    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                    billboard.AlwaysOnTop = true
                    billboard.Parent = container()

                    local text = Instance.new("TextLabel")
                    text.Size = UDim2.new(1, 0, 1, 0)
                    text.BackgroundTransparency = 1
                    text.Font = Enum.Font.GothamBold
                    text.TextSize = 12
                    text.TextStrokeTransparency = 0.3
                    text.TextColor3 = pumpkins.color
                    text.Parent = billboard

                    entry = { highlight = highlight, billboard = billboard, text = text }
                    pumpkins.cache[model] = entry
                end

                local dist = 0
                if myHrp then
                    dist = math.floor((myHrp.Position - anchor.Position).Magnitude)
                end
                local visible = dist <= pumpkins.maxDistance

                entry.highlight.Enabled = visible
                if visible then
                    entry.highlight.Adornee = model
                    entry.highlight.FillTransparency = pumpkins.fillTransparency
                end

                entry.billboard.Enabled = visible and pumpkins.label
                if visible then
                    entry.billboard.Adornee = anchor
                    entry.text.Text = model.Name .. " [" .. dist .. "m]"
                end
            end
        end
    end))

    -- Rayfield Gen2 blocks forever when a window already exists and its ScreenGui
    -- is UUID-named, so clear any previous window by its rendered text first.
    do
        local titles = {
            ["Asylum ESP + Taser Aim"] = true,
            ["Player ESP + Raycast"] = true,
            ["Candy Corn Collector"] = true,
        }
        local roots = {}
        pcall(function() table.insert(roots, game:GetService("CoreGui")) end)
        pcall(function()
            local h = gethui and gethui()
            if h then table.insert(roots, h) end
        end)
        for _, root in ipairs(roots) do
            if root then
                for _, gui in ipairs(root:GetChildren()) do
                    if gui:IsA("ScreenGui") then
                        local hit = false
                        for _, d in ipairs(gui:GetDescendants()) do
                            if (d:IsA("TextLabel") or d:IsA("TextButton"))
                                and titles[d.Text] then
                                hit = true
                                break
                            end
                        end
                        if hit then pcall(function() gui:Destroy() end) end
                    end
                end
            end
        end
    end

    local Window = Rayfield:CreateWindow({
        name = "Asylum",
        subtitle = "ESP / Event / Aim",
        sidebarLayout = true,
    })

    local EspTab = Window:CreateTab({ name = "ESP" })
    local EventTab = Window:CreateTab({ name = "Event" })

    EspTab:CreateToggle({
        name = "Enable ESP",
        value = true,
        forgetState = true,
        callback = function(v) esp.enabled = v end,
    })
    EspTab:CreateToggle({
        name = "Highlight (through walls)",
        value = true,
        callback = function(v) esp.highlight = v end,
    })
    EspTab:CreateToggle({
        name = "Name",
        value = true,
        callback = function(v) esp.name = v end,
    })
    EspTab:CreateToggle({
        name = "Distance",
        value = true,
        callback = function(v) esp.distance = v end,
    })
    EspTab:CreateToggle({
        name = "Health",
        value = true,
        callback = function(v) esp.health = v end,
    })
    EspTab:CreateToggle({
        name = "Use the game's HOSTILE tag",
        description = "Reads the nameplate the game itself shows above wanted players. Turn off only to fall back to the team list.",
        value = true,
        callback = function(v) esp.useTag = v end,
    })
    EspTab:CreateToggle({
        name = "Fallback: PATIENT",
        value = true,
        callback = function(v) esp.hostileTeams.PATIENT = v end,
    })
    EspTab:CreateToggle({
        name = "Fallback: CHOOSING",
        value = true,
        callback = function(v) esp.hostileTeams.CHOOSING = v end,
    })
    EspTab:CreateSlider({
        name = "Max distance",
        range = { 100, 5000 },
        increment = 100,
        value = 2000,
        suffix = " studs",
        callback = function(v) esp.maxDistance = v end,
    })
    EspTab:CreateSlider({
        name = "Highlight fill transparency",
        range = { 0, 1 },
        increment = 0.05,
        value = 0.75,
        callback = function(v) esp.fillTransparency = v end,
    })

    EventTab:CreateToggle({
        name = "Pumpkin ESP",
        value = true,
        callback = function(v) pumpkins.enabled = v end,
    })
    EventTab:CreateToggle({
        name = "Pumpkin distance labels",
        value = true,
        callback = function(v) pumpkins.label = v end,
    })
    EventTab:CreateSlider({
        name = "Pumpkin max distance",
        range = { 100, 6000 },
        increment = 100,
        value = 3000,
        suffix = " studs",
        callback = function(v) pumpkins.maxDistance = v end,
    })
    EspTab:CreateButton({
        name = "Unload script",
        callback = function()
            local handle = getgenv().Asylum
            if handle then pcall(function() handle.Unload() end) end
        end,
    })

    local AimTab = Window:CreateTab({ name = "Silent Aim" })


    local aimToggle
    aimToggle = AimTab:CreateToggle({
        name = "Enable silent aim",
        value = false,
        forgetState = true,
        callback = function(v) aim.enabled = v end,
    })

    AimTab:CreateToggle({
        name = "Taser Rifle (rewrite direction)",
        value = true,
        callback = function(v) aim.rifle = v end,
    })
    AimTab:CreateToggle({
        name = "Taser (rewrite hit part)",
        value = true,
        callback = function(v) aim.taser = v end,
    })
    AimTab:CreateDropdown({
        name = "Aim part",
        options = { "Head", "UpperTorso", "HumanoidRootPart" },
        value = "Head",
        callback = function(selected)
            aim.part = type(selected) == "table" and selected[1] or selected
        end,
    })
    AimTab:CreateToggle({
        name = "Wall check (line of sight)",
        description = "Off by default. Adds one cached raycast per candidate.",
        value = false,
        callback = function(v) aim.wallCheck = v end,
    })
    AimTab:CreateSlider({
        name = "FOV (full cone)",
        range = { 10, 360 },
        increment = 5,
        value = 80,
        suffix = " deg",
        callback = function(v) aim.fov = v end,
    })
    AimTab:CreateSlider({
        name = "Max distance",
        range = { 50, 3000 },
        increment = 50,
        value = 900,
        suffix = " studs",
        callback = function(v) aim.maxDistance = v end,
    })
    AimTab:CreateSlider({
        name = "Max turn per shot",
        description = "How far the shot direction may be rotated, in degrees. Measured ceiling is about 35 deg: beyond that the shot is discarded. Default 30 keeps a margin.",
        range = { 0, 180 },
        increment = 1,
        value = 30,
        suffix = " deg",
        callback = function(v) aim.maxAngle = v end,
    })

    local aimStats = AimTab:CreateText({ name = "Aim stats", text = "..." })

    AimTab:CreateButton({
        name = "Unload script",
        callback = function()
            local handle = getgenv().Asylum
            if handle then pcall(function() handle.Unload() end) end
        end,
    })

    track(RunService.Heartbeat:Connect(function()
        if getgenv().AsylumGeneration ~= generation then return end
        pcall(function()
            aimStats:Set(string.format(
                "enabled=%s  rifle=%s taser=%s  part=%s\n"
                    .. "shots seen  rifle=%d  taser=%d\n"
                    .. "rewritten   rifle=%d  taser=%d   finds=%d  blocked=%d\n"
                    .. "max turn=%.0f deg   last turn=%.1f deg",
                tostring(aim.enabled), tostring(aim.rifle), tostring(aim.taser),
                tostring(aim.part),
                aim.reads.rifle, aim.reads.taser,
                aim.rifleRewrites, aim.taserRewrites, aim.finds, aim.blocked,
                aim.maxAngle, aim.lastAngle))
        end)
    end))

    ------------------------------------------------------------------
    -- 6. Handle + unload
    ------------------------------------------------------------------
    local unload
    unload = function()
        -- Invalidate the generation first so no in-flight callback keeps writing.
        getgenv().AsylumGeneration = (getgenv().AsylumGeneration or generation) + 1
        for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
        connections = {}
        for player in pairs(cache) do dropEntry(player) end
        local parent = (gethui and gethui()) or game:GetService("CoreGui")
        local folder = parent:FindFirstChild("Asylum_ESP_Folder")
        if folder then pcall(function() folder:Destroy() end) end
        if original then
            pcall(function()
                local mt = getrawmetatable(game)
                setreadonly(mt, false)
                mt.__namecall = original
                setreadonly(mt, true)
            end)
        end
        pcall(function() Window:Unload() end)
        getgenv().Asylum = nil
    end

    getgenv().Asylum = {
        aim = aim,
        esp = esp,
        GetStats = function()
            return {
                hookInstalled = hookInstalled,
                espEnabled = esp.enabled,
                useTag = esp.useTag,
                taggedLabels = esp.tagged,
                hostileTeams = (function()
                    local t = {}
                    for k, v in pairs(esp.hostileTeams) do if v then t[#t + 1] = k end end
                    return t
                end)(),
                aim = {
                    enabled = aim.enabled,
                    rifle = aim.rifle,
                    taser = aim.taser,
                    part = aim.part,
                    rifleShotsSeen = aim.reads.rifle,
                    taserShotsSeen = aim.reads.taser,
                    rifleRewrites = aim.rifleRewrites,
                    taserRewrites = aim.taserRewrites,
                    finds = aim.finds,
                    blocked = aim.blocked,
                },
            }
        end,
        SetSilentAim = function(v)
            aim.enabled = v and true or false
            -- keep the widget in sync so the panel never disagrees with the state
            if aimToggle then pcall(function() aimToggle:Set(aim.enabled, true) end) end
        end,
        SetHostileTeams = function(list)
            esp.hostileTeams = {}
            for _, name in ipairs(list or {}) do esp.hostileTeams[name] = true end
        end,
        RefreshTags = function() refreshHostileLabels() end,
        Pumpkins = pumpkins,
        -- Diagnostic: say WHY each player is judged hostile or not.
        DebugHostiles = function()
            -- BillboardGui has no Visible property (only Enabled), so describe the
            -- parent by class instead of assuming a GuiObject.
            local function parentState(l)
                local p = l.Parent
                if not p then return "noParent" end
                if p:IsA("LayerCollector") then return p.ClassName .. ":enabled=" .. tostring(p.Enabled) end
                if p:IsA("GuiObject") then return p.ClassName .. ":vis=" .. tostring(p.Visible) end
                return p.ClassName
            end
            local rows = {}
            for player, list in pairs(hostileLabels) do
                if isHostile(player) then
                    local details = {}
                    for i = 1, #list do
                        local l = list[i]
                        details[#details + 1] = string.format("%s=(%s)", l.Name,
                            parentState(l))
                    end
                    rows[#rows + 1] = string.format("%s(%d) [%s]", player.Name, #list,
                        table.concat(details, " ; "))
                end
            end
            table.sort(rows)
            return rows
        end,
        AimTarget = function()
            local t = aimTarget()
            return t and (t:GetFullName() .. " [" .. t.ClassName .. "]") or nil
        end,
        Unload = function() unload() end,
    }

    getgenv().AsylumError = nil
    print("[Asylum] loaded. fire hook=" .. tostring(hookInstalled))
    return getgenv().Asylum
end

local ok, err = pcall(boot)
if not ok then
    getgenv().AsylumError = tostring(err)
    warn("[Asylum] " .. tostring(err))
end
return ok
